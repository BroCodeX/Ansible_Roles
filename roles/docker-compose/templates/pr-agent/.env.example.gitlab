# {{ ansible_managed }}
# https://docs.pr-agent.ai/installation/gitlab/#run-a-gitlab-webhook-server

# --- PR-Agent GitLab webhook server configuration ---
# Fill in real values before starting the stack. Never commit this file.

CONFIG__GIT_PROVIDER=gitlab

# GitLab access
GITLAB__PERSONAL_ACCESS_TOKEN={{ pr_agent_gitlab_gpat }}
GITLAB__SHARED_SECRET={{ pr_agent_shared_secret }}
GITLAB__URL={{ pr_agent_gitlab_url }}
# Use "private_token" instead of "oauth_token" for older GitLab versions
GITLAB__AUTH_TYPE=oauth_token

# LLM provider
OPENAI__KEY={{ pr_agent_openai_api }}
OPENROUTER__KEY={{ pr_agent_openrouter_api }}

# Optional: override the webhook server port (host-side mapping in docker-compose.yml)
PORT=3000
