{{ '---' }}
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_manifest_secret_name }}
  namespace: {{ k8s_manifest_namespace }}
  labels:
{{ k8s_manifest_common_labels | to_nice_yaml(indent=2) | trim('\n') | indent(4, first=True) }}
type: {{ k8s_manifest_secret_type }}
{% if k8s_manifest_secret_effective_data | length > 0 %}
stringData:
{% for key, value in k8s_manifest_secret_effective_data | dictsort %}
  {{ key }}: {{ value | string | to_json }}
{% endfor %}
{% else %}
stringData: {}
{% endif %}
