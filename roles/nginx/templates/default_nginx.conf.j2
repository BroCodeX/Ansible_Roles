# {{ ansible_managed }}

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

{% if nginx_modules %}
{% for module in nginx_modules %}
load_module {{ nginx_module_path }}/{{ module.filename }};
{% endfor %}
{% endif %}

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

{% if 'vts' in (nginx_modules | map(attribute='name') | list) %}
    vhost_traffic_status_zone shared:vhost_traffic_status:{{ nginx_vts_memory_allocated }};
{% endif %}

    log_format json_combined escape=json
      '{'
        '"remote_addr":"$remote_addr",'
        '"remote_user":"$remote_user",'
        '"time_local":"$time_local",'
        '"request":"$request",'
        '"status": $status,'
        '"body_bytes_sent": $body_bytes_sent,'
        '"http_referer":"$http_referer",'
        '"http_user_agent":"$http_user_agent",'
        '"http_x_forwarded_for":"$http_x_forwarded_for"'
      '}';

    access_log  /var/log/nginx/access.log  json_combined;

    sendfile        on;
    keepalive_timeout  65;
    include {{ nginx_vhosts_dst_dir }}/*.conf;

{% if 'vts' in (nginx_modules | map(attribute='name') | list) %}
    server {
        listen 127.0.0.1:{{ nginx_vts_port }} default_server
        server_name localhost;
        location /status {
            vhost_traffic_status_display;
            access_log off;
        }
    }
{% endif %}
}
