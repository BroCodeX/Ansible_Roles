# {{ ansible_managed }}

server {
    listen 443 ssl;
    http2 on;

    server_name {{ item }};
    server_tokens off;

    access_log /var/log/nginx/{{ item }}-access.log;
    error_log /var/log/nginx/{{ item }}-error.log warn;

    ssl_certificate /root/.acme.sh/{{ item }}_ecc/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/{{ item }}_ecc/{{ item }}.key;

    include {{ nginx_snippets_path }}/ssl.inc;
    include {{ nginx_snippets_path }}/acme.inc;

    location / {
        # some directives
    }
}

# HSTS
server {
    listen 80;

    server_name {{ item }};
    server_tokens off;

    include {{ nginx_snippets_path }}/acme.inc;

    location / {
        return 301 https://$host$request_uri;
    }
}
