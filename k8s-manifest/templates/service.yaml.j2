{{ '---' }}
apiVersion: v1
kind: Service
metadata:
  name: {{ k8s_manifest_name }}
  namespace: {{ k8s_manifest_namespace }}
  labels:
{{ k8s_manifest_common_labels | to_nice_yaml(indent=2) | trim('\n') | indent(4, first=True) }}
spec:
  type: {{ k8s_manifest_service_type }}
  selector:
    app.kubernetes.io/name: {{ k8s_manifest_name }}
  ports:
    - port: {{ k8s_manifest_service_port | int }}
      targetPort: {{ k8s_manifest_service_target_port | int }}
      protocol: TCP
