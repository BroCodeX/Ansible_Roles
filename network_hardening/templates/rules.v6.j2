# Managed by Ansible — do not edit manually.
*filter
:INPUT DROP [0:0]
:FORWARD {{ 'ACCEPT' if iptables_docker_enabled else 'DROP' }} [0:0]
:OUTPUT ACCEPT [0:0]

-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP

-A INPUT -p tcp --tcp-flags ALL ALL -m limit --limit 5/min -j LOG --log-prefix "XMAS-SCAN: "
-A INPUT -p tcp --tcp-flags ALL ALL -j DROP
-A INPUT -p tcp --tcp-flags ALL NONE -m limit --limit 5/min -j LOG --log-prefix "NULL-SCAN: "
-A INPUT -p tcp --tcp-flags ALL NONE -j DROP
-A INPUT -p tcp --tcp-flags FIN,SYN FIN,SYN -m limit --limit 5/min -j LOG --log-prefix "FIN-SYN-SCAN: "
-A INPUT -p tcp --tcp-flags FIN,SYN FIN,SYN -j DROP

{% for port in iptables_allowed_tcp_ports %}
-A INPUT -p tcp --dport {{ port }} -m conntrack --ctstate NEW -j ACCEPT
{% endfor %}

# ICMPv6 (NDP обязателен для корректной работы IPv6)
-A INPUT -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type neighbour-solicitation -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type neighbour-advertisement -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type router-advertisement -j ACCEPT
COMMIT
