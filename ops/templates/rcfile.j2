#!/bin/bash

[[ "$BASH_SOURCE" == "$0" ]] && {
    echo "Please 'source' this script, don't execute it directly"
    echo "e.g.:"
    echo "$ source $0"
    return 1 2> /dev/null || exit 1
}

export OS_AUTH_URL="{{ openstack_rc_profile.value.os_auth_url | default('https://cloud.api.selcloud.ru/identity/v3') }}"
export OS_IDENTITY_API_VERSION="{{ openstack_rc_profile.value.os_identity_api_version | default('3') }}"
export OS_VOLUME_API_VERSION="{{ openstack_rc_profile.value.os_volume_api_version | default('3') }}"

export CLIFF_FIT_WIDTH={{ openstack_rc_profile.value.cliff_fit_width | default(1) }}

export OS_PROJECT_DOMAIN_NAME='{{ openstack_rc_profile.value.os_project_domain_name }}'
export OS_PROJECT_ID='{{ openstack_rc_profile.value.os_project_id }}'
export OS_TENANT_ID='{{ openstack_rc_profile.value.os_tenant_id | default(openstack_rc_profile.value.os_project_id) }}'
export OS_REGION_NAME='{{ openstack_rc_profile.value.os_region_name }}'

export OS_USER_DOMAIN_NAME='{{ openstack_rc_profile.value.os_user_domain_name }}'
export OS_USERNAME='{{ openstack_rc_profile.value.os_username }}'

echo "Please enter your OpenStack Password: "
read -sr OS_PASSWORD_INPUT
export OS_PASSWORD=$OS_PASSWORD_INPUT
