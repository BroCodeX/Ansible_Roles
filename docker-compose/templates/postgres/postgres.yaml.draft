# {{ ansible_managed }}

name: {{ docker_compose_project_name }}

x-logging: &logging
  driver: "json-file"
  options:
    max-size: "10m"
    max-file: "5"

services:

  # Postgres
  postgres:
    image: postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
    volumes:
      - "postgres-data:/var/lib/postgresql"
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1024M
          pids: 300
        reservations:
          cpus: '0.5'
          memory: 256M
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    security_opt:
      - no-new-privileges=true
    read_only: true
    tmpfs:
      - /var/run/postgresql
      - /tmp
    networks:
      - db-net
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_DB=${POSTGRES_DB}
    logging: *logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

networks:
  db-net:
    name: db-net
    internal: true 

volumes:
  postgres-data:
